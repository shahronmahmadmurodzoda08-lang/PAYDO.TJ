rules_version = '2';

// PAYDO.TJ — Firestore Security Rules
// PHASE 1: танҳо коллексияи `users` муайян шудааст.
// Ҳар феча (marketplace, jobs, chat, ...) қоидаҳои худро дар феҷаи
// дахлдор илова мекунад — ин файлро дар PHASE 4+ идома медиҳем.
service cloud.firestore {
  match /databases/{database}/documents {

    // Корбар танҳо документи худро сохта/хонда/навишта метавонад.
    // Дигарон метавонанд профили ҷамъиятиро хонанд (масалан барои
    // намоиши profile-и seller дар marketplace), вале не тағйир диҳанд.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if false; // Ҳисобро тавассути admin panel нест кардан лозим (PHASE 19)
    }

    // Маҳсулот (PHASE 4/6): хондан барои ҳама кушода, навиштан танҳо
    // барои соҳиби маҳсулот (sellerId). Иҷозати "create" бе sellerId
    // = auth.uid дода намешавад, то корбар аз номи дигаре нанависад.
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
    }

    // Favorites (PHASE 4): ҳар корбар танҳо favorite-и худро идора
    // мекунад; docId бо конвенсияи `{uid}_{itemId}` сохта мешавад.
    match /favorites/{favoriteId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Бизнес (PHASE 5): documentId = ownerId (ниг. docs/database.md).
    // Хондан барои ҳама кушода (бизнес-профил бояд ҷамъиятӣ намоён
    // бошад), навиштан танҳо барои соҳиб.
    match /businesses/{ownerId} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.auth.uid == ownerId
                    && request.resource.data.ownerId == ownerId;
      allow delete: if false; // тавассути admin panel (PHASE 19)
    }

    // Orders (PHASE 7): items embedded (ниг. эзоҳи тарроҳӣ дар
    // lib/models/order_model.dart). Хондан: харидор ё яке аз
    // seller-ҳои дар sellerIds. Навиштан (create): танҳо харидор аз
    // номи худ. Тағйир (масалан status): харидор (cancel) ё seller
    // (пешрафти status).
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (resource.data.customerId == request.auth.uid
                      || request.auth.uid in resource.data.sellerIds);
      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.customerId == request.auth.uid
                        || request.auth.uid in resource.data.sellerIds);
      allow delete: if false;
    }

    // Chat (PHASE 8): chatId детерминистӣ (`{uid1}_{uid2}`, ниг.
    // lib/features/chat/domain/chat_repository.dart). Танҳо 2
    // иштирокчии дар `participantIds` метавонанд хонанд/нависанд.
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
                    && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; // хабарҳо ивазнашаванда/нестнашавандаанд
      }
    }

    // Вакансия (PHASE 9): хондан кушода, навиштан/тағйир/нест кардан
    // танҳо барои соҳиби вакансия (employerId).
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.employerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.employerId == request.auth.uid;
    }

    // Профили корҷӳ (PHASE 9): documentId = uid, ҳамон нақшаи
    // businesses/{ownerId}. Хондан кушода (барои ҳамон корфармоён
    // рӳйхати "Корҷӳён"-ро бинанд, ба ҷуз агар isVisible=false бошад —
    // он дар сатҳи client filter мешавад, на дар rules, зеро rules
    // намедонанд "ин query аз рӳи isVisible аст" бе санҳиши иловагӣ).
    match /worker_profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Аризаи корҷӳ (PHASE 9): docId = `{jobId}_{workerId}`. Хондан:
    // худи корҷӳ ё корфармои вакансия. Сохтан: танҳо корҷӳ аз номи худ.
    // Тағйир (қабул/рад): танҳо корфармо.
    match /job_applications/{applicationId} {
      allow read: if request.auth != null
                  && (resource.data.workerId == request.auth.uid
                      || resource.data.employerId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.workerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.employerId == request.auth.uid;
      allow delete: if false;
    }

    // Профили хизматрасон (PHASE 10): documentId = uid, ҳамон нақшаи
    // worker_profiles/businesses.
    match /services/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Фармоиши хизматрасонӣ (PHASE 10): хондан/тағйир барои харидор ё
    // хизматрасони дахлдор; сохтан танҳо аз номи худи харидор.
    match /service_orders/{orderId} {
      allow read: if request.auth != null
                  && (resource.data.customerId == request.auth.uid
                      || resource.data.providerId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.customerId == request.auth.uid
                        || resource.data.providerId == request.auth.uid);
      allow delete: if false;
    }

    // Ҳама коллексияҳои дигар то муайян шуданашон дар марҳилаҳои
    // дахлдор пурра баста мебошанд (default deny).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
