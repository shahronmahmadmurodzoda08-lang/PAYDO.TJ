rules_version = '2';

// PAYDO.TJ — Firebase Storage Security Rules
// PHASE 2: танҳо profile_photos. Дар PHASE 6 (products) ва PHASE 5
// (business) роҳҳои дигар илова мешаванд.
service firebase.storage {
  match /b/{bucket}/o {

    // Сурати профил: `profile_photos/{uid}.jpg`
    // Корбар танҳо файли худро бор карда метавонад; хондан барои
    // ҳама (сурати профил дар оянда дар product/chat/review намоён аст).
    match /profile_photos/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024 // < 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Сурати бизнес (PHASE 5): logo.jpg ва cover.jpg дар зерфайли
    // ownerId. Танҳо соҳиби бизнес бор карда метавонад.
    match /business_images/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == ownerId
                   && request.resource.size < 8 * 1024 * 1024 // < 8MB (cover калонтар)
                   && request.resource.contentType.matches('image/.*');
    }

    // Сурати маҳсулот (PHASE 6): зерфайли sellerId, номи файл = uuid.
    match /product_images/{sellerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == sellerId
                   && request.resource.size < 5 * 1024 * 1024 // < 5MB
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == sellerId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
